{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ideomancer Graph Manifest",
  "description": "Graph schema 0.1.0. Duplicate node IDs and edge references are checked by the Rust semantic validator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "nodes"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "id": { "type": "string", "pattern": "\\S" },
    "name": { "type": "string", "pattern": "\\S" },
    "nodes": {
      "type": "array",
      "default": [],
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "label": { "type": ["string", "null"] },
        "kind": { "type": ["string", "null"], "pattern": "\\S" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "label": { "type": ["string", "null"] }
      }
    }
  }
}
